-
-    return {
-        "total_cases": len(cases),
-        "total_answered": total_answered,
-        "total_passed": total_passed,
-        "per_case": per_case,
-    }
-
-
-# ---------------------------------------------------------------------------
-# CLI
-# ---------------------------------------------------------------------------
-
-def _main(argv: list[str]) -> int:
