-
-
-# ---------------------------------------------------------------------------
-# Batch grading
-# ---------------------------------------------------------------------------
-
-def grade_run(
-    cases: list[dict],
-    answers: dict[str, dict[str, Any]],
-) -> dict:
-    """Grade all answers in *answers* against *cases*.
